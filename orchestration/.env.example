SN_INSTANCE_URL=https://devXXXXX.service-now.com
SN_CLIENT_ID=your_oauth_client_id
SN_CLIENT_SECRET=your_oauth_client_secret
# Set this to the value of the "Awaiting User Info" incident state in your instance.
# SN_AWAITING_USER_INFO_STATE=your_choice_value
# SN_IN_PROGRESS_STATE=your_choice_value
# User-confirmed Closed choice for this instance.
SN_CLOSED_STATE=3
# Set only if the instance requires a closure code.
# SN_CLOSE_CODE=your_choice_value

WEBHOOK_SECRET=your_webhook_secret
WEBHOOK_PORT=8000

ASSIGNMENT_GROUP=TCS-BDX-ITLEARNING

# PostgreSQL URI: use the Supabase session-pooler URI when IPv4 is needed.
DATABASE_URL=postgresql://postgres.project_ref:encoded_password@your-session-pooler:5432/postgres?sslmode=require
# Create this schema first; LangGraph manages its four checkpoint tables inside it.
SUPABASE_SCHEMA=c2c

LLM_MODEL_1=your_model_name
LLM_MODEL_1_BASE_URL=http://localhost:8080/v1
# LLM_MODEL_1_API_KEY=your_api_key_if_required

NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j

# Optional when Tesseract is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
